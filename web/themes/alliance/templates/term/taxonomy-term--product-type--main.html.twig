{% if term.parent.value.0.target_id == 0 %}
  <section class="home-promo">
    <div class="home-promo__swiper-wrapper">
      <div class="container">
        <h1>{{ content.field_title }}</h1>
        {% if term.field_video.0 is not empty %}
          <div class="home-promo__slide-title">{{ term.field_video.0.entity.field_title.value }}</div>
          <div class="home-promo__swiper-btns">
            <div class="home-promo__swiper-btn home-promo__swiper-btn--prev swiper-button-prev"></div>
            <div class="home-promo__swiper-btn home-promo__swiper-btn--next swiper-button-next"></div>
          </div>
        {% endif %}
      </div>
      {% if term.field_video.0 is not empty %}
        <div class="swiper home-promo__swiper">
        <div class="swiper-wrapper">
          {% for video in term.field_video  %}
            <div class="swiper-slide">
              <div class="home-promo__slide" data-title="{{ video.entity.field_title.value }}">
                <div class="home-promo__slide-video">
                <video muted="" loop="" playsinline="">
                  <source src="{{ file_url(video.entity.field_video_mp4.entity.uri.value) }}" type="video/mp4">
                  <source src="{{ file_url(video.entity.field_video_webm.entity.uri.value) }}" type="video/webm">
                </video>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    <div>
  </section>
  {# <section class="home-promo">
    <h1>{{ content.field_title }}</h1>
    <div class="home-promo__subtitle">{{ content.field_title2 }}</div><a class="btn" href="#">Рассчитать стоимость</a>
    <div class="home-promo__video">
      <video autoplay="" muted="" loop="" playsinline="">
        <source src="/themes/alliance/dist/video/video.mp4" type="video/mp4">
        <source src="/themes/alliance/dist/video/video.webm" type="video/webm">
      </video>
    </div>
  </section> #}

  <section class="home-links">
    <div class="container">

      <ul>

        {% for links in term.field_links %}

        <li> <a href=" {{ links.entity.field_link.0.url }}">
            <div class="home-links__title">{{ links.entity.field_title.value | raw }}</div>
            <div class="home-links__descr">{{ links.entity.field_description.value | raw }}</div>
            <div class="home-links__img">{{ links.entity.field_image | renderThis }}</div></a></li>
        {% endfor %}

      </ul>
    </div>
  </section>
  <section class="home-calc">
    <div class="container">
      <div class="wrapper">
        <h2>{{ term.field_title_form.value }}</h2>

        <ul>
          {% for step in term.field_step_form %}
            <li value="{{ loop.index }}">{{ step.value }}</li>
          {% endfor %}
        </ul>
        <h3>Ваши контактные данные</h3>
        <form action="" class="modal-form">
          <input type="hidden" name="webform_id" value="callback">
          <input type="hidden" name="url" value="{{ url('<current>') }}">
          <div class="form-item name">
            <input id="homeName" type="text" name="name" required placeholder="Ваше имя*">
          </div>
          <div class="form-item phone">
            <input id="homePhone" type="tel" name="phone" required placeholder="Телефон*">
          </div>
          <div class="form-item submit">
            <input class="btn" type="submit" value="Отправить">
          </div>
          <div class="form-item person"> <span>Отправляя форму, вы даете согласие на&nbsp</span><a href="/policy" target="_blank">обработку персональных данных </a></div>
          <div class="form-item req"> <span>*Поля обязательны к заполнению</span></div>
        </form>
      </div>
    </div>
  </section>
  <section class="home-why">
    <div class="container">
      <h2>Вот почему нас выбирают и возвращаются</h2>
      <ul>
        {% for why in term.field_why %}
          <li>
            <div class="title">{{ why.entity.field_title.value }}</div>
            <div class="descr">{{ why.entity.field_description.value | raw }}</div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  <section class="home-info">
    <div class="container">
      <h2>{{ term.field_slogan.value }}</h2><a class="btn" href="#">Рассчитать стоимость</a>
      <div class="home-info__text">{{ content.description }}</div>
    </div>
  </section>
{% endif %}
