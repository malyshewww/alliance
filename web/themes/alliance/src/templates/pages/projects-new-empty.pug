extends ../layout/main

block append variables
	- const pageTitle = "Проекты";
	//- - const pageTitle_OFF = true;
	- const bodyClass = "project-page";

block content
	main.projects
		include ../blocks/breadcrumbs
		.container
			include ../blocks/filters
			button(type="button").filters__btn-sticky.btn.active Фильтры
			.projects__empty
				.projects__empty-text.title-h5 Нет подходящих проектов
				button(type="button" data-filter-reset).btn.projects__empty-btn Сбросить фильтры 